# Ghostty configuration.
#
# Run `ghostty +show-config --default --docs` to view all available options.
# Docs: https://ghostty.org/docs/config

# Remove vertical padding so tmux status bar sits flush with the window edge.
window-padding-y = 0

keybind = option+backspace=text:\x1b\x7f
background = #050b0c

custom-shader = shaders/glide.glsl
custom-shader-animation = always
